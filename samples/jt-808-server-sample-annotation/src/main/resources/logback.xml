<configuration scan="true" scanPeriod="10 seconds">
    <contextName>logback</contextName>

    <!-- 日志目录和归档上限可通过同名系统属性或环境变量覆盖。 -->
    <property name="LOG_DIR" value="${JT_LOG_DIR:-logs/808/server-annotation}"/>
    <property name="ARCHIVE_FILE_SIZE" value="${JT_LOG_MAX_FILE_SIZE:-100MB}"/>
    <property name="ARCHIVE_DAYS" value="${JT_LOG_MAX_HISTORY:-2}"/>
    <property name="ARCHIVE_TOTAL_SIZE" value="${JT_LOG_TOTAL_SIZE_CAP:-2GB}"/>

    <conversionRule conversionWord="clr"
                    converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wEx"
                    converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>
    <property name="CONSOLE_LOG_PATTERN"
              value="${CONSOLE_LOG_PATTERN:-%clr(%d{yyyy-MM-dd'T'HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%-5level}) %clr([${PID:-?}/%thread]){magenta} %clr(%logger{48}:%line){cyan} | %msg%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}"/>
    <property name="FILE_LOG_PATTERN"
              value="${FILE_LOG_PATTERN:-%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level [%thread] %logger{48}:%line | %msg%n%ex}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 每个文件只接收对应级别；DEBUG 是否产生仍由 logger 的级别决定。 -->
    <appender name="DEBUG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <onMismatch>DENY</onMismatch>
            <onMatch>ACCEPT</onMatch>
            <level>DEBUG</level>
        </filter>
        <file>${LOG_DIR}/debug.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/debug-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>${ARCHIVE_DAYS}</maxHistory>
            <totalSizeCap>${ARCHIVE_TOTAL_SIZE}</totalSizeCap>
            <maxFileSize>${ARCHIVE_FILE_SIZE}</maxFileSize>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <onMismatch>DENY</onMismatch>
            <onMatch>ACCEPT</onMatch>
            <level>INFO</level>
        </filter>
        <file>${LOG_DIR}/info.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/info-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>${ARCHIVE_DAYS}</maxHistory>
            <totalSizeCap>${ARCHIVE_TOTAL_SIZE}</totalSizeCap>
            <maxFileSize>${ARCHIVE_FILE_SIZE}</maxFileSize>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="WARN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <onMismatch>DENY</onMismatch>
            <onMatch>ACCEPT</onMatch>
            <level>WARN</level>
        </filter>
        <file>${LOG_DIR}/warn.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/warn-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>${ARCHIVE_DAYS}</maxHistory>
            <totalSizeCap>${ARCHIVE_TOTAL_SIZE}</totalSizeCap>
            <maxFileSize>${ARCHIVE_FILE_SIZE}</maxFileSize>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <onMismatch>DENY</onMismatch>
            <onMatch>ACCEPT</onMatch>
            <level>ERROR</level>
        </filter>
        <file>${LOG_DIR}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>${ARCHIVE_DAYS}</maxHistory>
            <totalSizeCap>${ARCHIVE_TOTAL_SIZE}</totalSizeCap>
            <maxFileSize>${ARCHIVE_FILE_SIZE}</maxFileSize>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="DEBUG_FILE"/>
        <appender-ref ref="INFO_FILE"/>
        <appender-ref ref="WARN_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
